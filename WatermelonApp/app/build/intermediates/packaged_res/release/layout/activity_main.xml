<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F2B1C"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🍉 西瓜熟度检测"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="敲击声音 · 频谱主频判断（专利CN109459499A）"
            android:textColor="#9FE6B8"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="点击下方按钮开始"
            android:textColor="#ECFDF5"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/bigNum"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="--"
            android:textColor="#FACC15"
            android:textSize="88sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/verdict"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="等待检测"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/detail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text=""
            android:textColor="#C9F2D9"
            android:textSize="15sp"
            android:gravity="center" />

        <Button
            android:id="@+id/btn"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="28dp"
            android:backgroundTint="#22C55E"
            android:text="🎤 开始检测"
            android:textColor="#052E16"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="使用步骤：\n1. 点击开始检测，授权麦克风\n2. 手机底部贴近西瓜表面\n3. 用手指快速敲击西瓜一次\n4. 稍候显示主频与熟度\n\n熟度说明（1-9）：\n1-3 生 · 4-5 适熟 · 6 熟 · 7-9 过熟"
            android:textColor="#9FE6B8"
            android:textSize="14sp"
            android:lineSpacingMultiplier="1.2" />

    </LinearLayout>
</ScrollView>